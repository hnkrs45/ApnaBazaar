# ========================================================
# ApnaBazaar Backend Environment Configuration
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
server_url=http://localhost:3000
client_url=http://localhost:5173

# Database & Auth
MONGO_URL=mongodb://localhost:27017/E-Commerce
SECRET_KEY=your_jwt_secret_key_here

# ========================================================
# Google OAuth 2.0 Authentication
# ========================================================
# Obtain Client ID & Secret from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Payments (Razorpay)
RAZORPAY_ID_KEY=rzp_test_yourkeyhere
RAZORPAY_SECRET_KEY=yoursecretkeyhere

# ========================================================
# AI Provider Configuration (Google Gemini)
# ========================================================
# Obtain API key from Google AI Studio: https://aistudio.google.com/
# Recommended small/fast/low-cost model: gemini-flash-lite-latest
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Request timeout in milliseconds (default: 2000ms / 2s before falling back to Layers 1-2)
AI_TIMEOUT_MS=2000
